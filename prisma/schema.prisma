model Visit {
  id            String   @id @default(uuid()) @map("_id")
  date          DateTime @default(now()) // Store the date of the visit
  desktopVisits Int      @default(0) // Track desktop visits
  mobileVisits  Int      @default(0) // Track mobile visits
  visitors      String[] @default([]) // Store persistent visitor IDs

  @@unique([date]) // Ensure one record per day
}

model Blog {
  id        String   @id @default(uuid()) @map("_id")
  title     String
  excerpt   String   @unique
  content   String
  tags      String[] @default([])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade) // Blog belongs to a User

  likes   BlogLike[]
  Comment Comment[]
}

model Comment {
  id         String          @id @default(uuid()) @map("_id")
  content    String
  blogId     String
  author     User            @relation(fields: [authorId], references: [id])
  authorId   String
  parent     Comment?        @relation(name: "CommentToComment", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId   String?         @default(null)
  replies    Comment[]       @relation(name: "CommentToComment")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  likes      CommentLike[]
  reports    CommentReport[]
  replyCount Int             @default(0)
  Video      Blog            @relation(fields: [blogId], references: [id])

  @@index([blogId])
  @@index([parentId])
  @@index([authorId])
}

model CommentLike {
  id        String   @id @default(uuid()) @map("_id")
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model CommentReport {
  id        String   @id @default(uuid()) @map("_id")
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([commentId, userId])
  @@index([userId])
  @@index([status])
}

model BlogLike {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  blogId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blogId]) // Ensure a user can only like a blog once
}

model Folder {
  id        String   @id @default(uuid()) @map("_id") // Use auto() for MongoDB
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Folder[] @relation("FolderToFolder")
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id        String   @id @default(uuid()) @map("_id") // Use auto() for MongoDB
  name      String
  type      String
  size      Int?
  url       String
  folderId  String?
  publicId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
